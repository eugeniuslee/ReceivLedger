{
  "name": "receivledger-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "npx --yes deno check --config supabase/functions/registry/deno.json supabase/functions/registry/index.ts supabase/functions/registry-v2/index.ts",
    "test": "vitest run",
    "compile:v2": "node scripts/compile-v2.mjs",
    "test:solidity": "node --test test/v2/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "ethers": "^6.13.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@openzeppelin/contracts": "5.6.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "pdf-lib": "^1.17.1",
    "solc": "0.8.38",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
